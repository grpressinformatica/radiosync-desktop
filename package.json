{
  "name": "radiosync-desktop",
  "version": "1.4.0",
  "description": "RadioSync Desktop - Cadastro de Ouvintes e Promoções/Sorteios (offline)",
  "author": "UaiHost",
  "main": "./.output/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && npx electron-forge make --platform win32",
    "package:msix": "npm run build && electron-builder --win --x64 --config electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --x64 --config electron-builder.linux.yml --publish never"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "sonner": "^2.0.0",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-msix": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
